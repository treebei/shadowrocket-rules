#!name=adblock
#!version=2026.10.23.1
#!desc=高德、阿里、微信、菜鸟及 Bilibili 广告拦截；路径与正文过滤需启用 HTTPS 解密并信任证书。

[Rule]
# 高德
DOMAIN,adashx.ut.amap.com,REJECT
DOMAIN,v6-adashx.ut.amap.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
DOMAIN,logs.amap.com,REJECT
DOMAIN,optimus-ads.amap.com.w.alikunlun.com,REJECT
DOMAIN-KEYWORD,optimus-ads,REJECT

# 淘宝 / 天猫 / 阿里
DOMAIN-SUFFIX,adash.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashx.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashx.ut.taobao.com,REJECT
DOMAIN-SUFFIX,h-adashx.ut.taobao.com,REJECT
DOMAIN-SUFFIX,adashbc.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashbc.ut.taobao.com,REJECT
DOMAIN-SUFFIX,adashxgc.ut.taobao.com,REJECT
DOMAIN-SUFFIX,m-adash.m.taobao.com,REJECT
DOMAIN-SUFFIX,mmstat.com,REJECT
DOMAIN-SUFFIX,alimama.com,REJECT
DOMAIN-SUFFIX,tanx.com,REJECT
DOMAIN-SUFFIX,ifs.tanx.com,REJECT
DOMAIN-SUFFIX,m.simaba.taobao.com,REJECT
DOMAIN-SUFFIX,tns.simba.taobao.com,REJECT
DOMAIN-SUFFIX,afp.alicdn.com,REJECT
DOMAIN-SUFFIX,atanx.alicdn.com,REJECT

# 微信 / 腾讯
DOMAIN,wxsnsdy.wxs.qq.com,REJECT
DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-SUFFIX,beacon.qq.com,REJECT
DOMAIN-SUFFIX,bugly.qq.com,REJECT
DOMAIN-SUFFIX,rqd.qq.com,REJECT
DOMAIN,adsmind.tc.qq.com,REJECT
DOMAIN,btrace.qq.com,REJECT
DOMAIN,mtrace.qq.com,REJECT
DOMAIN,oth.eve.mdt.qq.com,REJECT
DOMAIN,pgdt.gtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,pingma.qq.com,REJECT
DOMAIN,pingtcss.qq.com,REJECT
DOMAIN,tajs.qq.com,REJECT

# 菜鸟裹裹
DOMAIN,nbcps-mtop.cainiao.com,REJECT

[URL Rewrite]
# 高德
^https?:\/\/(?:m\d+(?:-zb)?|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/aos\/alimama\/splash_screen(?:_rt)?(?:[/?]|$) - reject-200
^https?:\/\/(?:m\d+(?:-zb)?|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/valueadded\/alimama\/splash_screen(?:[/?]|$) - reject
^https?:\/\/m\d+(?:-zb)?\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init(?:[/?]|$) - reject-dict
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan(?:[/?]|$) - reject-dict
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/v\d+\/ai_rec\/ - reject-dict
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/asa\/ads_attribution(?:[/?]|$) - reject
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/shield\/scene\/recommend(?:[/?]|$) - reject-dict

# 菜鸟裹裹
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn(?:[/?]|$) - reject-200
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?!.*_home) - reject-200
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get\.cn(?:[/?]|$) - reject
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.app\.home\.v\d+\.bottom\.area(?:[./?]|$) - reject-200
^https?:\/\/(?:guide-acs|acs4miniapp-inner)\.m\.taobao\.com\/gw\/(?:mtop\.cainiao\.guoguo\.nbnetflow\.ads\.|mtop\.cainiao\.adx\.flyad\.getad(?:[./?]|$)|mtop\.alimama\.abyss\.unionpage\.get(?:[./?]|$)) - reject-200

# Bilibili
^https?:\/\/app\.(?:bilibili\.com|biliapi\.net)\/x\/v2\/splash\/(?:list|show|event\/list2)(?:[/?]|$) - reject-dict

[Body Rewrite]
# Bilibili
http-response-jq ^https?:\/\/app\.(?:bilibili\.com|biliapi\.net)\/x\/v2\/feed\/index(?:[/?]|$) 'if (.data.items | type) == "array" then .data.items |= map(select(((.card_type // "") | test("^cm($|_)")) | not)) else . end'
http-response-jq ^https?:\/\/app\.(?:bilibili\.com|biliapi\.net)\/x\/v2\/search(?:[/?]|$) 'if (.data.item | type) == "array" then .data.item |= map(select(((.linktype // "") | endswith("_ad")) | not)) else . end'

[MITM]
hostname = %APPEND% m*.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com, *.cainiao.com, guide-acs.m.taobao.com, acs4miniapp-inner.m.taobao.com, app.bilibili.com, app.biliapi.net
