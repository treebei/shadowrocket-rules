#!name=adblock
#!desc=合并高德、阿里、微信、菜鸟域名规则及高德、菜鸟广告 URL 拦截；URL 拦截需要 HTTPS 解密。
# 来源与适配：ddgksf2013 的 AmapAds.conf；小白脸菜鸟包裹规则（NobyDa 频道转发）。
# https://github.com/ddgksf2013/Rewrite/blob/master/AdBlock/AmapAds.conf
# https://t.me/NobyDa/1017
# 在 Shadowrocket 的配置 > 模块中添加本文件的 Raw URL。
# 需要在当前配置启用 HTTPS 解密，并生成、安装和完全信任自己的 Shadowrocket 证书。
# 不包含证书、私钥或远程执行脚本；不自动开启 HTTPS 解密。
# 已下载的广告缓存可能继续展示；先清理 App 缓存再完全退出并重新启动。
# 已内置 ad-block.txt 的全部域名规则；启用本模块后无需再单独引用该规则集。
# 请确保本模块的 REJECT 规则在相关 DIRECT / 放行规则之前生效。
# 域名拦截不需要 HTTPS 解密；首页混合业务响应中的推广卡片需另行分析。
# 未在实际 iPhone / App 上验证；如业务异常，可停用本模块。

[Rule]
# 高德 / AMap 广告与日志
DOMAIN,adashx.ut.amap.com,REJECT
DOMAIN,v6-adashx.ut.amap.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
DOMAIN,logs.amap.com,REJECT
DOMAIN,optimus-ads.amap.com.w.alikunlun.com,REJECT
DOMAIN-KEYWORD,optimus-ads,REJECT

# 阿里系 / 淘宝 / 天猫 广告与统计
DOMAIN-SUFFIX,adash.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashx.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashx.ut.taobao.com,REJECT
DOMAIN-SUFFIX,h-adashx.ut.taobao.com,REJECT
DOMAIN-SUFFIX,adashbc.m.taobao.com,REJECT
DOMAIN-SUFFIX,adashbc.ut.taobao.com,REJECT
DOMAIN-SUFFIX,adashxgc.ut.taobao.com,REJECT
DOMAIN-SUFFIX,m-adash.m.taobao.com,REJECT
DOMAIN-SUFFIX,mmstat.com,REJECT
DOMAIN-SUFFIX,alimama.com,REJECT
DOMAIN-SUFFIX,tanx.com,REJECT
DOMAIN-SUFFIX,ifs.tanx.com,REJECT
DOMAIN-SUFFIX,m.simaba.taobao.com,REJECT
DOMAIN-SUFFIX,tns.simba.taobao.com,REJECT
DOMAIN-SUFFIX,afp.alicdn.com,REJECT
DOMAIN-SUFFIX,atanx.alicdn.com,REJECT

# 微信 / 腾讯广告 / 朋友圈广告相关
DOMAIN,wxsnsdy.wxs.qq.com,REJECT
DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-SUFFIX,beacon.qq.com,REJECT
DOMAIN-SUFFIX,bugly.qq.com,REJECT
DOMAIN-SUFFIX,rqd.qq.com,REJECT
DOMAIN,adsmind.tc.qq.com,REJECT
DOMAIN,btrace.qq.com,REJECT
DOMAIN,mtrace.qq.com,REJECT
DOMAIN,oth.eve.mdt.qq.com,REJECT
DOMAIN,pgdt.gtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,pingma.qq.com,REJECT
DOMAIN,pingtcss.qq.com,REJECT
DOMAIN,tajs.qq.com,REJECT

# 菜鸟裹裹 / Cainiao 广告
DOMAIN,nbcps-mtop.cainiao.com,REJECT

[URL Rewrite]
# 高德：开屏请求
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/aos\/alimama\/splash_screen(?:[/?]|$) - reject

# 高德：开屏广告
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/valueadded\/alimama\/splash_screen(?:[/?]|$) - reject

# 高德：路线规划下方推广
^https?:\/\/(?:m5|m5-zb|center|amap-aos-info-nogw|ai)\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\? - reject

# 菜鸟：首页商品推广
^https?:\/\/nbcps-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn(?:[/?]|$) - reject

# 菜鸟：广告信息流
^https?:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.index(?:[./?]|$) - reject

# 菜鸟：搜索栏推广
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get\.cn(?:[/?]|$) - reject

# 菜鸟：推广展示
^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.m?show(?:[./?]|$) - reject

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com, nbcps-mtop.cainiao.com, netflow-mtop.cainiao.com, cn-acs.m.cainiao.com
